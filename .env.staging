# ── STAGING ENVIRONMENT ───────────────────────────────────────────────────────
# Uses Meta's test phone number from the WhatsApp Cloud API dashboard.
# Safe for internal testing and client validation.

# WhatsApp Cloud API — Meta test number
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxx_YOUR_TEMPORARY_TEST_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_TEST_PHONE_NUMBER_ID
WHATSAPP_VERIFY_TOKEN=staging_verify_secret_change_me
META_API_VERSION=v21.0

# App
APP_ENV=staging
LOG_LEVEL=debug

# Database — SQLite is fine for staging
DATABASE_URL=sqlite:///polaritech_staging.db

# Welcome flow
WHATSAPP_WELCOME_IMAGE_URL=https://your-cdn.com/polaritech-cotizacion.jpg
WHATSAPP_WELCOME_IMAGE_ID=
WELCOME_WINDOW_HOURS=24.0

# Escalation
ESCALATION_PHONE_NUMBER=+50688001234
