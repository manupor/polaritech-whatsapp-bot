# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
# Use Meta test number + test token for staging.
# Use real business number + permanent token for production.
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxx...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=my_secret_verify_token
META_API_VERSION=v21.0

# ── OpenAI (for future use) ──────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key

# ── App settings ─────────────────────────────────────────────────────────────
# Values: development | staging | production
APP_ENV=development
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite for dev/staging, PostgreSQL for production:
#   postgresql://user:pass@host:5432/polaritech
DATABASE_URL=sqlite:///polaritech.db

# ── Welcome flow ─────────────────────────────────────────────────────────────
WHATSAPP_WELCOME_IMAGE_URL=https://your-cdn.com/polaritech-cotizacion.jpg
WHATSAPP_WELCOME_IMAGE_ID=
WELCOME_WINDOW_HOURS=24.0

# ── Escalation ───────────────────────────────────────────────────────────────
ESCALATION_PHONE_NUMBER=+50688001234
