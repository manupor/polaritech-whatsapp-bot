# ── PRODUCTION ENVIRONMENT ────────────────────────────────────────────────────
# Uses the client's real WhatsApp Business number.
# Requires completed onboarding via WhatsApp Business App + Cloud API coexistence.
#
# IMPORTANT:
#   - The client keeps using WhatsApp Business App normally.
#   - This bot connects to the same number via Cloud API (coexistence mode).
#   - Messages from customers arrive to both the app and the webhook.
#   - When human_takeover=true in the dashboard, the bot stops auto-replying
#     and the human agent responds via WhatsApp Business App.
#   - Use a permanent System User token (never a temporary developer token).

# WhatsApp Cloud API — real business number
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxx_PERMANENT_SYSTEM_USER_TOKEN
WHATSAPP_PHONE_NUMBER_ID=REAL_BUSINESS_PHONE_NUMBER_ID
WHATSAPP_VERIFY_TOKEN=production_verify_secret_change_me
META_API_VERSION=v21.0

# App
APP_ENV=production
LOG_LEVEL=info

# Database — use PostgreSQL for production
DATABASE_URL=postgresql://polaritech:password@localhost:5432/polaritech

# Welcome flow
WHATSAPP_WELCOME_IMAGE_URL=https://your-cdn.com/polaritech-cotizacion.jpg
WHATSAPP_WELCOME_IMAGE_ID=
WELCOME_WINDOW_HOURS=24.0

# Escalation
ESCALATION_PHONE_NUMBER=+50688001234
